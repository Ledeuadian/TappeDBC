# Copy this file to .env.local and fill in your project's values.
# Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# Public base URL of this app. Used to build absolute URLs for QR codes
# and NFC records printed/encoded on physical cards.
# Include the scheme but NO trailing slash, e.g. https://tappe.ph
VITE_PUBLIC_APP_URL=https://your-domain.com
